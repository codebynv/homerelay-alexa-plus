# ============================================================
# HomeRelay Environment Configuration Example
# ============================================================

# Frontend Build Time (apps/web)
# Set to your deployed or local Express backend URL
VITE_API_BASE=http://localhost:4000

# Backend Runtime (apps/server)
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed frontend origins (or * for development)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Alexa Skill Lambda Runtime (apps/alexa)
# Auto-configured by AWS SAM template, or point to local/deployed MCP endpoint
MCP_URL=http://localhost:4001/mcp
