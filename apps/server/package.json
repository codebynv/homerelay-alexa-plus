  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/aws-lambda": "^8.10.133",
    "@types/jest": "^29.5.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  }
